{
  "name": "meu-atacado-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x", "npm": "11.x" },
  "packageManager": "npm@11.11.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start --network-id meuatacado-local",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local --network-id meuatacado-local",
    "db:lint": "supabase db lint --local --schema public,private --level warning --fail-on warning --network-id meuatacado-local",
    "db:test": "supabase test db --network-id meuatacado-local"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
