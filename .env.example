# Copie para .env.local ao configurar a conexão pública Supabase.
# A página inicial, os testes e o build de F0 não precisam destas variáveis.
# Use valores locais ou de desenvolvimento. Veja docs/14-supabase-remoto.md.
NEXT_PUBLIC_SUPABASE_URL=<supabase-api-url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-or-local-anon-key>
# Origem canônica do app, sem caminho; necessária somente para os fluxos Auth.
APP_URL=<app-origin-https-or-local-http>
# Nenhuma chave administrativa é necessária em F0.
# Opcionais, exclusivos do servidor, para convites. Nunca usar NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=<supabase-secret-or-local-service-role-key>
SMTP_HOST=<smtp-host>
SMTP_PORT=<smtp-port>
SMTP_FROM=<sender-email>
SMTP_USER=<smtp-user-if-required>
SMTP_PASSWORD=<smtp-password-if-required>
